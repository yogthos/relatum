{:paths ["src"]

 :deps {}

 :aliases
 {;; jolt -M:test
  :test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts   ["-m" "relatum.test-runner"]}

  ;; jolt -M:specs, the writ laws over the pure namespaces: the type
  ;; vocabulary and the DDL planner. Green means writ's report is :ok; most
  ;; laws are property-checked rather than proved, and the runner prints how
  ;; many of each.
  :specs {:extra-paths ["spec"]
          :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}
                        org.clojure/core.logic {:mvn/version "1.1.1"}
                        io.github.jlt-commons/writ
                        {:git/url "https://github.com/jlt-commons/writ"
                         :git/tag "v0.1.14"
                         :git/sha "11ea31dfd4f261332df3b227c37c962e30eefb4e"}}
          :main-opts   ["-m" "relatum.spec-runner"]}}}
